# Server Configuration
PORT=3000
NODE_ENV=development
CLOUD_RUN_SERVICE_URL=
CORS_ORIGIN=*

# Auth
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=30d
SALT_ROUNDS=10
SESSION_COOKIE_MAX_AGE=2592000000

# Database
DATABASE_URL=
PGBOSS_SCHEMA=pgboss
# Optional: maximum number of Postgres connections used by pg-boss
PGBOSS_POOL_MAX=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_BASE_FOLDER=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Resend (email delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@zentry.app
RESEND_FROM_NAME=Zentry

# External APIs

# Logging & Monitoring
LOG_ALL_LOGS_PATH=./logs/server.log
LOG_ERROR_LOGS_PATH=./logs/error.log
SENTRY_DSN=

# OpenTelemetry (ClickStack / HyperDX)
OTEL_EXPORTER_OTLP_ENDPOINT=http://clickstack:4318
HYPERDX_API_KEY=
OTEL_TRACE_DB_CLIENTS=false
OTEL_TRACE_REDIS_CLIENTS=false
OTEL_DISABLE_METRICS=false
