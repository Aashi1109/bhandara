{
  "name": "server",
  "version": "1.0.0",
  "main": "src/index.ts",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && tscpaths -p tsconfig.build.json -s ./src -o ./dist",
    "start": "node dist/index.js",
    "start:worker": "node dist/src/workers/index.js",
    "start:worker:video": "WORKER_TYPE=video-processor node dist/src/workers/index.js",
    "dev": "nodemon --watch src --ext ts --exec \"tsx -r tsconfig-paths/register\" src/index.ts",
    "dev:worker": "tsx -r tsconfig-paths/register src/workers/index.ts",
    "dev:worker:video": "WORKER_TYPE=video-processor tsx -r tsconfig-paths/register src/workers/index.ts",
    "migrate": "tsx -r tsconfig-paths/register scripts/runSqlMigrations.ts",
    "migrate:run": "pnpm migrate",
    "migrate:sql": "pnpm migrate",
    "seed": "tsx -r tsconfig-paths/register src/misc/seeder.ts",
    "seed:fresh": "tsx -r tsconfig-paths/register src/misc/seeder.ts",
    "seed:clusters": "tsx -r tsconfig-paths/register src/misc/seedClusterEvents.ts",
    "video-worker": "tsx -r tsconfig-paths/register src/workers/video-processor",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.70.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/instrumentation-express": "^0.60.0",
    "@opentelemetry/instrumentation-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@sentry/node": "^10.39.0",
    "@supabase/postgrest-js": "^1.19.4",
    "@supabase/supabase-js": "^2.97.0",
    "@upstash/redis": "^1.36.2",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.5",
    "base64-arraybuffer": "^1.0.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.69.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.6",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tscpaths": "^0.0.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
